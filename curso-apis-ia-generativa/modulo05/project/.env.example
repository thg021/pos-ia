OPENROUTER_API_KEY=cole_aqui_a_sua_chave_do_openrouter

LANGSMITH_API_KEY=cole_aqui_a_chave_que_voce_copiou_no_langsmith
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=modulo05-guardrails-mcp-filesystem

# Modelo dedicado a detectar prompt injection, usado só pelo guardrail — nunca
# recebe as ferramentas MCP, mesmo que o modelo do agente principal receba.
SAFEGUARD_MODEL=openai/gpt-oss-safeguard-20b

# Arquivo com os usuários de teste (papel + permissões), usado no lugar de um
# banco de dados para manter o exemplo focado em segurança de prompt.
USERS_FILE_PATH=./data/users.json

# Liga/desliga a camada de guardrails. Comece com "false" para reproduzir a
# falha de prompt injection (Passo 6 do tutorial), depois mude para "true"
# para ver a defesa em ação (Passo 12) — ver README.md.
GUARDRAILS_ENABLED=true
