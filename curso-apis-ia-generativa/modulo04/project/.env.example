OPENROUTER_API_KEY=cole_aqui_a_sua_chave_do_openrouter

LANGSMITH_API_KEY=cole_aqui_a_chave_que_voce_copiou_no_langsmith
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=modulo04-recomendador-musica-memoria

# Connection string do Postgres local usado para checkpointer + store do LangGraph
# (histórico de mensagens da conversa). Suba o banco com `docker compose up -d`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/modulo04

# Arquivo SQLite local usado para persistir preferências extraídas do cliente
# (nome, idade, gêneros, bandas) e o resumo mais recente da conversa.
PREFERENCES_DB_PATH=./data/preferences.db

# Quantidade de mensagens no histórico a partir da qual o grafo aciona o
# resumo automático (RemoveMessage podando as mensagens mais antigas).
# Um valor baixo (ex: 6) ajuda a observar o resumo acontecendo durante o
# desenvolvimento; em produção esse número tende a ser bem maior.
MAX_MESSAGES_TO_SUMMARIZE=6
